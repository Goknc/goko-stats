# .env.example — copy to .env and fill in the values. Never commit real values (.env is git-ignored).
# .env.example — .env adıyla kopyala ve değerleri doldur. Gerçek değerleri asla commit'leme.

# PostgreSQL connection (Prisma)
# Local example: postgresql://USER:PASSWORD@localhost:5432/gokostats?schema=public
# Hosted (Neon / Supabase): use the pooled connection string with sslmode=require
DATABASE_URL=

# Bzzoiro Sports Data API token (https://sports.bzzoiro.com) — only needed by the sync scripts
BSD_API_TOKEN=
