{
  "name": "gokostats",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest",
    "postinstall": "prisma generate",
    "db:seed": "tsx prisma/seed.ts",
    "sync:daily": "(tsx scripts/sync-seasons.ts || echo Sezon adimi basarisiz, devam ediliyor) && tsx scripts/sync-matches.ts && tsx scripts/sync-details.ts --limit 10000 && tsx scripts/sync-lineups.ts --hours 48",
    "sync:lineups": "tsx scripts/sync-lineups.ts --hours 3",
    "sync:player-extras": "tsx scripts/sync-player-extras.ts",
    "sync:players": "tsx scripts/sync-player-profiles.ts --career 800",
    "test:e2e": "next build && playwright test",
    "test:e2e:dev": "playwright test"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@fontsource-variable/caveat": "^5.3.0",
    "@fontsource-variable/outfit": "^5.3.0",
    "@fontsource/anton": "^5.3.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "date-fns": "^4.4.0",
    "dotenv": "^18.0.5",
    "lucide-react": "^1.52.0",
    "next": "16.3.8",
    "pg": "^8.23.1",
    "react": "19.2.8",
    "react-day-picker": "^10.0.2",
    "react-dom": "19.2.8",
    "shadcn": "^4.21.3",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.19.1",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "prisma": "^7.10.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.3"
  }
}
